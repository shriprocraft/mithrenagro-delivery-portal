# Copy to .env.local (git-ignored). NEXT_PUBLIC_ values are built into the browser bundle,
# so never put secrets here.

# The shared Mithren Agro FastAPI backend (mithren-agro-backend). Requests go to
# ${NEXT_PUBLIC_API_BASE_URL}/api/v1/... The backend must list this portal's origin
# (http://127.0.0.1:3000 and http://localhost:3000) in CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
